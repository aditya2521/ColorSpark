# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native – keep ios source, exclude generated/binary dirs
.kotlin/
*.orig.*
ios/Pods/
ios/build/
ios/.xcode.env.local
ios/MobileGame.xcworkspace/xcuserdata/
ios/MobileGame.xcodeproj/xcuserdata/
/android

# Signing / secrets – never commit
*.jks
*.p8
*.p12
*.key
*.mobileprovision
google-service-account.json

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env files
.env*.local

# TypeScript
*.tsbuildinfo

# Backups and temp
*.bak
*.tmp
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
