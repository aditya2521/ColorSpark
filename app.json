{
  "expo": {
    "name": "ColorSpark",
    "slug": "colorspark",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "com.colorspark.app",
    "description": "ColorSpark is a fun color-by-number game with 200 unique images, 40+ vibrant palettes, and 4 difficulty tiers. Perfect for kids and adults. No ads, no in-app purchases — free to play!",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF5"
    },
    "ios": {
      "bundleIdentifier": "com.colorspark.app",
      "buildNumber": "3",
      "supportsTablet": true,
      "requireFullScreen": true,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "CFBundleDisplayName": "ColorSpark",
        "UIRequiresFullScreen": true,
        "UIStatusBarStyle": "UIStatusBarStyleDefault",
"ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.colorspark.matchblend",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio"
    ],
    "extra": {
      "privacyPolicyUrl": "https://colorspark-21.web.app/privacy",
      "termsUrl": "https://colorspark-21.web.app/terms",
      "supportUrl": "https://colorspark-21.web.app",
      "supportEmail": "aditya159121@gmail.com",
      "eas": {
        "projectId": "ad72fed8-9593-46c2-8ae3-ee1cdf000b16"
      }
    },
    "owner": "aditya2125"
  }
}
